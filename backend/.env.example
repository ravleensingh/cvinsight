# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Create a new cluster at https://cloud.mongodb.com and paste the connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cvinsight?retryWrites=true&w=majority

# ─── Frontend URLs ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=
ADDITIONAL_ALLOWED_ORIGINS=
# Set to true when deploying on Vercel to allow preview URLs
ALLOW_VERCEL_PREVIEWS=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_access_secret_min_64_chars
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=25
ACCOUNT_DELETION_GRACE_DAYS=7
OTP_EXPIRY_MINUTES=10

# ─── Email / Nodemailer ───────────────────────────────────────────────────────
# Preferred: configure your SMTP provider directly
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_SERVICE=
EMAIL_USER=notifications@example.com
EMAIL_PASS=replace_with_email_password_or_app_password
EMAIL_FROM="CVInsight <notifications@example.com>"

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# ─── AI Model (Groq) ──────────────────────────────────────────────────────────
# Used only for narrative text generation after ML/heuristic screening.
MODEL_PROVIDER=groq
GROQ_API_KEY=gsk_replace_with_your_groq_api_key
MODEL_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1/chat/completions
MODEL_NAME=llama-3.3-70b-versatile

# ─── Local Resume ML Scoring ─────────────────────────────────────────────────
# Default model should stay ml3 for resume-job fit until calibration says otherwise.
RESUME_ML_MODEL=ml3
ML_MODELS_DIR=../ml_models
ML_PYTHON_PATH=../ml_models/.venv/bin/python
ML_SCORING_TIMEOUT_MS=45000
ENABLE_MODEL_RESUME_EXTRACTION=false
